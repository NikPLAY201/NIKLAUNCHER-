data class VersionManifest(
    val id: String,
    val name: String,
    val clientUrl: String?,
    val libraries: List<Library>,
    val mainClass: String
)

data class Library(val name: String, val url: String)

class LauncherCore(private val context: Context) {

    fun getAvailableVersions(): List<VersionManifest> {
        // читаем из assets/versions/*.json или с сервера
        return listOf(
            VersionManifest("1.20.1", "1.20.1 (Fabric)", null, emptyList(), "net.fabricmc.loader.launch.FabricLauncher"),
            VersionManifest("1.2.3_03_mystic", "1.2.3_03 (Mystic)", null, emptyList(), "net.minecraft.client.Minecraft")
        )
    }

    fun launchVersion(version: VersionManifest, account: Account) {
        if (!account.isLicensed && version.id != "trial") {
            showMessage("Требуется лицензия. Запуск в режиме Trial.")
            // здесь можно выбрать trial-версию вместо этой
            return
        }
        val javaArgs = buildJavaArgs(version, account)
        val command = buildLaunchCommand(javaArgs)
        Runtime.getRuntime().exec(command)
    }

    private fun buildJavaArgs(version: VersionManifest, account: Account): List<String> {
        val args = mutableListOf<String>()
        args.add("-Xmx2G") // пример выделения памяти
        args.add("-cp")
        args.add(buildClasspath(version))
        args.add(version.mainClass)
        // добавить аргументы аккаунта, UUID, имя игрока и т.д.
        return args
    }

    private fun buildClasspath(version: VersionManifest): String {
        // собрать путь ко всем JAR-библиотекам и клиенту
        return ""
    }

    private fun buildLaunchCommand(args: List<String>): String {
        // в Android это будет Intent или запуск через Runtime.exec с нативным Java
        return "java ${args.joinToString(" ")}"
    }
}
