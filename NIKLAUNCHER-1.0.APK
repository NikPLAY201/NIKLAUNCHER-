data class Account(
    val id: String,
    val name: String,          // имя игрока (username)
    val type: AccountType,    // Microsoft / Local
    val isLicensed: Boolean,   // только для Microsoft
    var skinPath: String?      // путь к локальному скину
)

enum class AccountType { Microsoft, Local }
fun pickSkinFromStorage(launcherDir: File, account: Account) {
    // тут вызывается Intent для выбора файла из галереи/хранилища
    // после выбора:
    val dest = File(launcherDir, "profiles/${account.id}/skin.png")
    sourceFile.copyTo(dest, overwrite = true)
    account.skinPath = dest.absolutePath
}
