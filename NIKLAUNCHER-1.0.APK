VersionManifest("1.2.3_03_mystic", "1.2.3_03 (Mystic)", null, listOf(...), "net.minecraft.client.Minecraft")
fun prepareModsForVersion(versionId: String, loaderType: LoaderType, modsDir: File) {
    val modsToInstall = when (loaderType) {
        LoaderType.FABRIC -> listOf(
            "sodium-fabric-1.20.1.jar",
            "iris-fabric-1.20.1.jar"
        )
        LoaderType.FORGE -> listOf(
            "magnesium-forge-1.20.1.jar",
            "oculus-forge-1.20.1.jar"
        )
        else -> emptyList()
    }

    modsToInstall.forEach { modFileName ->
        val src = getModFromAssets(modFileName) // из assets лаунчера
        val dst = File(modsDir, modFileName)
        src.copyTo(dst, overwrite = true)
    }
}
@Composable
fun ModsScreen(viewModel: ModsViewModel) {
    Column(modifier = Modifier.fillMaxSize()) {
        Text(text = "Mods for ${viewModel.selectedVersion}", style = MaterialTheme.typography.headlineMedium)
        
        LazyColumn {
            items(viewModel.mods) { mod ->
                Row(
                    modifier = Modifier.fillMaxWidth().padding(8.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Column {
                        Text(text = mod.name, style = MaterialTheme.typography.titleMedium)
                        Text(text = mod.filename, style = MaterialTheme.typography.bodySmall, color = Color.Gray)
                    }
                    Switch(checked = mod.isEnabled, onCheckedChange = { viewModel.toggleMod(mod) })
                }
            }
        }

        Button(onClick = { /* открыть файловый менеджер */ }) {
            Text("Add mod")
        }
    }
}
